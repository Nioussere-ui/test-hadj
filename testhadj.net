<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KAMAs Invest | Register</title>
  <style>
    :root {
      --bg: #f3f6fb;
      --card: #ffffff;
      --text: #132238;
      --muted: #607289;
      --primary: #1366d6;
      --primary-hover: #0f55b2;
      --border: #dbe5f0;
      --success: #0f9d58;
      --shadow: 0 24px 55px rgba(13, 34, 66, 0.14);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      color: var(--text);
      background: radial-gradient(circle at 8% 0%, #eef5ff 0%, #f7f9fd 35%, #f4fff8 100%);
      min-height: 100vh;
      padding: 28px 16px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .shell {
      width: min(1150px, 100%);
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: var(--shadow);
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
    }

    .marketing {
      padding: 44px;
      background: linear-gradient(160deg, #f6fbff 0%, #ebfff8 100%);
      border-right: 1px solid var(--border);
    }

    .kicker {
      display: inline-block;
      padding: 7px 13px;
      border-radius: 999px;
      border: 1px solid #bed4f1;
      background: #edf4ff;
      color: #295ea6;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    h1 {
      margin: 14px 0 10px;
      font-size: 2.02rem;
      line-height: 1.2;
    }

    .lead {
      margin: 0 0 24px;
      color: var(--muted);
      line-height: 1.55;
      max-width: 45ch;
    }

    .benefits {
      margin: 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 12px;
    }

    .benefits li {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 13px;
      color: #35506c;
      background: #fff;
      font-size: 0.94rem;
    }

    .form-panel {
      padding: 36px;
      background: #fff;
    }

    .form-panel h2 {
      margin: 0 0 6px;
      font-size: 1.45rem;
    }

    .hint {
      margin: 0 0 20px;
      color: var(--muted);
      font-size: 0.93rem;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .field { margin-bottom: 12px; }

    label {
      display: block;
      margin-bottom: 6px;
      font-size: 0.9rem;
      font-weight: 700;
      color: #425d79;
    }

    input, select {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 11px 12px;
      font-size: 0.95rem;
      color: var(--text);
      background: #fff;
      outline: none;
    }

    input:focus, select:focus {
      border-color: #5f9ceb;
      box-shadow: 0 0 0 3px rgba(95, 156, 235, 0.2);
    }

    .row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 8px 0 18px;
      color: #4c6580;
      font-size: 0.89rem;
    }

    .row input { width: auto; }

    .btn {
      width: 100%;
      border: none;
      border-radius: 10px;
      background: var(--primary);
      color: #fff;
      font-size: 1rem;
      font-weight: 700;
      padding: 13px 14px;
      cursor: pointer;
    }

    .btn:hover { background: var(--primary-hover); }

    .sub {
      margin-top: 12px;
      color: var(--muted);
      font-size: 0.85rem;
      text-align: center;
    }

    .result {
      margin-top: 14px;
      border: 1px solid #bbe8cd;
      background: #f1fff6;
      color: #0f5132;
      padding: 12px;
      border-radius: 10px;
      display: none;
    }

    .warn {
      color: #8a6d1e;
      background: #fff8e6;
      border: 1px solid #f3dd98;
      border-radius: 10px;
      padding: 10px;
      font-size: 0.85rem;
      margin-top: 12px;
    }

    @media (max-width: 940px) {
      .shell { grid-template-columns: 1fr; }
      .marketing { border-right: none; border-bottom: 1px solid var(--border); }
    }

    @media (max-width: 620px) {
      .marketing, .form-panel { padding: 24px 18px; }
      .grid { grid-template-columns: 1fr; }
      h1 { font-size: 1.6rem; }
    }
  </style>
</head>
<body>
  <main class="shell">
    <section class="marketing">
      <span class="kicker">KAMAs Invest • Portail sécurisé</span>
      <h1>Investissez intelligemment avec KAMAs</h1>
      <p class="lead">Créez votre compte investisseur pour accéder à votre espace, suivre vos rendements et démarrer votre plan d'investissement en ligne.</p>

      <ul class="benefits">
        <li>📈 Tableau de bord investisseur avec suivi des performances.</li>
        <li>🔒 Vérification sécurisée et protection des données personnelles.</li>
        <li>💳 Dépôts simplifiés et assistance dédiée KAMAs Invest.</li>
      </ul>
    </section>

    <section class="form-panel">
      <h2>Ouvrir un compte investisseur</h2>
      <p class="hint">Veuillez renseigner vos informations pour finaliser l'inscription.</p>

      <form id="register-form">
        <div class="grid">
          <div class="field">
            <label for="firstName">Prénom</label>
            <input id="firstName" name="firstName" type="text" required>
          </div>
          <div class="field">
            <label for="lastName">Nom</label>
            <input id="lastName" name="lastName" type="text" required>
          </div>
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" placeholder="vous@exemple.com" required>
        </div>

        <div class="field">
          <label for="phone">Téléphone</label>
          <input id="phone" name="phone" type="tel" placeholder="+226 70 12 34 56" required>
        </div>

        <div class="grid">
          <div class="field">
            <label for="country">Pays</label>
            <select id="country" name="country" required>
              <option value="">Sélectionnez</option>
              <option value="BF">Burkina Faso</option>
              <option value="CI">Côte d'Ivoire</option>
              <option value="SN">Sénégal</option>
              <option value="TG">Togo</option>
            </select>
          </div>
          <div class="field">
            <label for="currency">Devise</label>
            <select id="currency" name="currency" required>
              <option value="">Sélectionnez</option>
              <option value="XOF">XOF</option>
              <option value="EUR">EUR</option>
              <option value="USD">USD</option>
            </select>
          </div>
        </div>

        <div class="grid">
          <div class="field">
            <label for="password">Mot de passe</label>
            <input id="password" name="password" type="password" minlength="8" required>
          </div>
          <div class="field">
            <label for="confirmPassword">Confirmer le mot de passe</label>
            <input id="confirmPassword" name="confirmPassword" type="password" minlength="8" required>
          </div>
        </div>

        <div class="field">
          <label for="promo">Code partenaire (optionnel)</label>
          <input id="promo" name="promo" type="text" placeholder="Ex: 4ML7ODNY6">
        </div>

        <label class="row" for="terms">
          <input id="terms" type="checkbox" required>
          <span>J'accepte les conditions d'utilisation et la politique de confidentialité KAMAs Invest.</span>
        </label>

        <button class="btn" type="submit">S'inscrire maintenant</button>
      </form>

      <div class="result" id="result"></div>
      <div class="warn">Note: Ceci est une maquette de page d'inscription KAMAs Invest (design original, non copie de marque tierce).</div>
      <p class="sub">Déjà membre ? Connectez-vous depuis votre espace investisseur.</p>
    </section>
  </main>

  <script>
    const form = document.getElementById('register-form');
    const result = document.getElementById('result');

    function generateInvestorId() {
      return `INV-${new Date().getFullYear()}-${Math.random().toString(36).slice(2, 8).toUpperCase()}`;
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      const password = document.getElementById('password').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      if (password !== confirmPassword) {
        result.style.display = 'block';
        result.style.borderColor = '#f3c6cf';
        result.style.background = '#fff3f5';
        result.style.color = '#842029';
        result.textContent = 'Erreur: les mots de passe ne correspondent pas.';
        return;
      }

      const investorId = generateInvestorId();
      result.style.display = 'block';
      result.style.borderColor = '#bbe8cd';
      result.style.background = '#f1fff6';
      result.style.color = '#0f5132';
      result.textContent = `Compte créé avec succès ✅ Votre identifiant investisseur: ${investorId}`;
      form.reset();
    });
  </script>
</body>
</html>
